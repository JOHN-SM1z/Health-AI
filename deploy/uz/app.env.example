# Health AI app settings on the Uzbekistan server. Copy to app.env (chmod 600) and fill in.
# Never commit app.env. Generate every secret with: openssl rand -hex 32

# ---- Addresses ----
NEXT_PUBLIC_APP_URL=https://healthai.uz
NEXT_PUBLIC_SUPABASE_URL=https://api.healthai.uz
# The anon key from scripts/generate-keys.mjs (public: it is inlined into the browser bundle).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_ANON_KEY=
# The service-role key from scripts/generate-keys.mjs (secret: server only).
SUPABASE_SERVICE_ROLE_KEY=

# ---- Platform owner (scripts/create-owner.ts only) ----
OWNER_EMAIL=
OWNER_NAME=

# ---- Telegram ----
# Clinic bots' tokens live in the database; these protect the webhooks. New random values are fine:
# `npm run sync-telegram-bots` re-registers every bot with the secret derived from them.
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_IDS=
ENABLE_TELEGRAM_DEV_MODE=false

# ---- Scheduler (pg_cron calls /api/notifications/process with it; the same value goes into Vault) ----
CRON_SECRET=

# ---- Switched off until the contracts exist (production refuses half configurations) ----
PAYMENT_PROVIDER=manual
NEXT_PUBLIC_PAYMENT_PROVIDER=manual
ONLINE_PAYMENT_PROVIDER=none
SMS_PROVIDER=none
# OneID: after the agreement. The callback registered with OneID is https://healthai.uz/api/oneid/callback
ONEID_CLIENT_ID=
ONEID_CLIENT_SECRET=
ONEID_SCOPE=

# ---- Logs ----
LOG_FORMAT=json
LOG_LEVEL=info
CLINIC_TIMEZONE=Asia/Tashkent
