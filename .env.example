# =============================================================================
# Health AI — environment variables
# Copy this file to .env.local and fill in real values when you have them.
# NEVER commit .env.local or real secrets.
# =============================================================================

# ---- App ----
# Public URL of the application (no trailing slash).
# Development: http://localhost:3000
# Production:  https://app.healthai.uz
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Comma-separated list of allowed CORS origins for browser API calls.
# Leave empty if you are not sure.
NEXT_PUBLIC_ALLOWED_ORIGINS=

# ---- Supabase ----
# From Supabase Dashboard > Project Settings > API.
# Public anon key — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — SERVER-SIDE ONLY. NEVER expose in browser code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Supabase Auth redirect URLs (comma separated) ----
# List of callback URLs Supabase Auth may redirect to after login.
SUPABASE_AUTH_REDIRECT_URLS=http://localhost:3000/admin

# ---- Staff bootstrap ----
# Email of the first clinic owner, created by `npm run create-owner`.
# This script must be run ONCE per clinic. Protect the service-role key.
OWNER_BOOTSTRAP_EMAIL=owner@example.com
OWNER_BOOTSTRAP_PASSWORD=

# ---- Telegram ----
# Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Secret token sent as X-Telegram-Bot-Api-Secret-Token on webhook calls.
# Must be set when the webhook is registered (see docs/telegram-setup.md).
TELEGRAM_WEBHOOK_SECRET=

# Public HTTPS webhook URL (production): https://app.healthai.uz/api/telegram/webhook
# Leave empty in local development.
TELEGRAM_WEBHOOK_URL=

# Comma-separated chat IDs of administrators that receive operational alerts.
# Optional. Example: 123456789,987654321
TELEGRAM_ADMIN_CHAT_IDS=

# Set to "true" ONLY for local development without a real bot.
# In production this must be "false".
ENABLE_TELEGRAM_DEV_MODE=false

# ---- AI provider (optional, OpenAI-compatible) ----
# Base URL of an OpenAI-compatible chat completions endpoint.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
# Model name, e.g. gpt-4o-mini, deepseek-chat, groq/llama-3.3-70b-versatile
AI_MODEL=gpt-4o-mini
# Temperature for the AI receptionist.
AI_TEMPERATURE=0.2
# Set to "true" to enable the AI receptionist. Deterministic fallback is used when off.
ENABLE_AI=false

# ---- Transcription provider (optional, OpenAI-compatible) ----
TRANSCRIPTION_BASE_URL=https://api.openai.com/v1
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=whisper-1
# Set to "true" to enable voice-message transcription.
ENABLE_TRANSCRIPTION=false

# ---- Payments ----
# Active payment provider: "manual" (development / clinic-assisted) is the only
# built-in provider. Real providers (e.g. Click, Payme) are documented adapters.
PAYMENT_PROVIDER=manual

# ---- Notifications / cron ----
# Secret used to authenticate the reminder-processing endpoint
# (Cloud Scheduler -> POST /api/notifications/process with Bearer token).
CRON_SECRET=change-me-in-production

# ---- Logging ----
# "json" (production, Cloud Logging) or "pretty" (local development).
LOG_FORMAT=pretty
# Minimum log level: debug | info | warn | error
LOG_LEVEL=info
