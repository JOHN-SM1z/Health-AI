[TEMPLATE]
# =============================================================================
# Health AI — environment variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or real secrets.
# =============================================================================

# ===================== Required =====================

# Supabase (Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key — SERVER-SIDE ONLY. Never expose in browser code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Telegram bot token (from @BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCdef...

# Webhook verification secret (X-Telegram-Bot-Api-Secret-Token).
# Any long random string — MUST match the secret_token in setWebhook.
# Production fails closed if TELEGRAM_BOT_TOKEN is set without this.
TELEGRAM_WEBHOOK_SECRET=your-random-secret

# Secret for the reminder cron endpoint. MUST be changed from the default.
CRON_SECRET=change-me-in-production

# ===================== Optional =====================

# Absolute https URL of the app — enables the "Qabulga yozilish" Mini App
# button in bot messages (domain must be whitelisted in @BotFather).
# NEXT_PUBLIC_APP_URL=https://your-domain.com

# Comma-separated admin chat IDs for alerts: 123456789,987654321
# TELEGRAM_ADMIN_CHAT_IDS=

# AI receptionist (OpenAI-compatible). Off unless ENABLE_AI=true.
# ENABLE_AI=false
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=
# AI_MODEL=gpt-4o-mini
# AI_TEMPERATURE=0.2

# Voice transcription (OpenAI-compatible). Off unless ENABLE_TRANSCRIPTION=true.
# ENABLE_TRANSCRIPTION=false
# TRANSCRIPTION_BASE_URL=https://api.openai.com/v1
# TRANSCRIPTION_API_KEY=
# TRANSCRIPTION_MODEL=whisper-1

# Logging: json (production) or pretty (local); debug|info|warn|error
# LOG_FORMAT=pretty
# LOG_LEVEL=info

# Local dev only: simulate the bot without a real token (never in production)
# ENABLE_TELEGRAM_DEV_MODE=false

# Staff bootstrap — only used by `npm run create-owner` (run locally once)
# OWNER_EMAIL=owner@example.com
# OWNER_PASSWORD=
# OWNER_NAME=Klinika egasi
