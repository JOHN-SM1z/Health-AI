[TEMPLATE]
# =============================================================================
# Health AI — environment variables
# Copy this file to .env.local and fill in real values when you have them.
# NEVER commit .env.local or real secrets.
#
# Legend: [REQUIRED]  app breaks / fails closed without it
#         [OPTIONAL]  gates a feature that is off by default
# =============================================================================

# ---- App ----
# [OPTIONAL] Public URL used for absolute booking links in Telegram
# messages. Omit if unused. Local dev: http://localhost:3000
NEXT_PUBLIC_APP_URL=

# [OPTIONAL] Shows a local-only dev-mode hint in the Mini App UI.
# Never set in production.
NEXT_PUBLIC_TELEGRAM_DEV_MODE=false

# [OPTIONAL] Version string surfaced by GET /api/health. Defaults to "dev".
NEXT_PUBLIC_APP_VERSION=

# ---- Supabase ----
# From Supabase Dashboard > Project Settings > API.
# [REQUIRED] Public anon key — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# [REQUIRED] Service role key — SERVER-SIDE ONLY. NEVER expose in browser code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Clinic ----
# [OPTIONAL] Defaults to Asia/Tashkent. Slot / availability math.
CLINIC_TIMEZONE=Asia/Tashkent

# ---- Staff bootstrap (script-only — run `npm run create-owner` locally once) ----
# Not read by the running app; only by the bootstrap script.
OWNER_EMAIL=owner@example.com
# Min 12 characters — set a real password.
OWNER_PASSWORD=
OWNER_NAME=Klinika egasi
CLINIC_NAME=Mening Klinikam
CLINIC_SLUG=my-clinic
CLINIC_PHONE=
CLINIC_ADDRESS=

# ---- Telegram ----
# [OPTIONAL] Bot token from @BotFather. Without it the bot is disabled.
TELEGRAM_BOT_TOKEN=

# [REQUIRED if TELEGRAM_BOT_TOKEN is set] Sent as
# X-Telegram-Bot-Api-Secret-Token on webhook calls. Production startup
# fails closed when the bot token is set without it.
TELEGRAM_WEBHOOK_SECRET=

# [OPTIONAL] Used only by the webhook registration step
# (docs/telegram-setup.md). Not read at runtime.
TELEGRAM_WEBHOOK_URL=

# [OPTIONAL] Comma-separated admin chat IDs for operational alerts.
# Example: 123456789,987654321
TELEGRAM_ADMIN_CHAT_IDS=

# [LOCAL DEV ONLY] "true" simulates the bot without a real token.
# MUST be "false" in production — startup fails closed.
ENABLE_TELEGRAM_DEV_MODE=false

# ---- AI provider (OPTIONAL, OpenAI-compatible) ----
# AI receptionist. Off by default; a deterministic fallback answers
# instead. ENABLE_AI is the master switch — the rest are only needed
# when it is "true".
ENABLE_AI=false
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
# e.g. gpt-4o-mini, deepseek-chat, groq/llama-3.3-70b-versatile
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.2

# ---- Transcription provider (OPTIONAL, OpenAI-compatible) ----
# Voice-message transcription. Off by default; ENABLE_TRANSCRIPTION is
# the master switch.
ENABLE_TRANSCRIPTION=false
TRANSCRIPTION_BASE_URL=https://api.openai.com/v1
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=whisper-1

# ---- Payments ----
# [REQUIRED] Only "manual" is implemented. Any other value fails at
# startup in production. Do not change until a Click/PayMe adapter ships.
PAYMENT_PROVIDER=manual

# ---- Notifications / cron ----
# [REQUIRED in production] Authenticates POST /api/notifications/process.
# MUST be changed from the default — production startup fails closed.
CRON_SECRET=change-me-in-production

# ---- Logging ----
# [OPTIONAL] "json" (production, Cloud Logging) or "pretty" (local).
LOG_FORMAT=pretty
# debug | info | warn | error
LOG_LEVEL=info
