    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "playwright": "1.56.1",
    "postgres": "^3.4.9",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
